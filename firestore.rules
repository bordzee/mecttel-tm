rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Roles live in profiles/{uid}. "superadmin" is set by hand (console or the admin
    // tool) and can manage admins; "admin" runs tournaments.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Deleting a division or tournament needs a delete grant: a short-lived document the
    // admin can only create by presenting the master password's proof. The grant is
    // written first, so a wrong password stops everything before any data is touched.
    function hasDeleteGrant(grantId) {
      return exists(/databases/$(database)/documents/delete_grants/$(grantId))
        && get(/databases/$(database)/documents/delete_grants/$(grantId)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/delete_grants/$(grantId)).data.created_at > request.time - duration.value(3, 'm');
    }

    function isString(v) {
      return v is string;
    }

    function isInt(v) {
      return v is int;
    }

    function matchStatus(v) {
      return v in ['scheduled', 'completed', 'pending'];
    }

    function knockoutRound(v) {
      return v in [
        'r128', 'r64', 'r32', 'r16',
        'quarter', 'semi', 'third_place', 'final',
      ];
    }

    function optionalKnockoutSourceId(v) {
      return v == null || isString(v);
    }

    function optionalSourceFeeder(v) {
      return v == null || v in ['winner', 'loser'];
    }

    function matchOutcome(v) {
      return v in ['normal', 'forfeit', 'no_show', 'dq', 'bye'];
    }

    function eventIsPublic(tournamentId, eventId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId))
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)).data.status in ['upcoming', 'ongoing'];
    }

    function teamIsPublic(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && eventIsPublic(
          get(/databases/$(database)/documents/teams/$(teamId)).data.tournament_id,
          get(/databases/$(database)/documents/teams/$(teamId)).data.event_id
        );
    }

    function groupIsPublic(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && eventIsPublic(
          get(/databases/$(database)/documents/groups/$(groupId)).data.tournament_id,
          get(/databases/$(database)/documents/groups/$(groupId)).data.event_id
        );
    }

    function scopedEventFields() {
      return isString(request.resource.data.tournament_id)
        && isString(request.resource.data.event_id);
    }

    // Scores are non-negative integers; a winner, when set, is one of the two entries;
    // a completed match has both scores, a winner, and no tie.
    function validResult() {
      let d = request.resource.data;
      return (d.score_a == null || (isInt(d.score_a) && d.score_a >= 0))
        && (d.score_b == null || (isInt(d.score_b) && d.score_b >= 0))
        && (d.winner_entry_id == null || d.winner_entry_id == d.entry_a_id || d.winner_entry_id == d.entry_b_id)
        && (d.status != 'completed'
          || (d.winner_entry_id != null && d.score_a != null && d.score_b != null && d.score_a != d.score_b));
    }

    function validMatchWrite() {
      return scopedEventFields()
        && isString(request.resource.data.entry_a_id)
        && isString(request.resource.data.entry_b_id)
        && matchStatus(request.resource.data.status)
        && matchOutcome(request.resource.data.outcome)
        && validResult();
    }

    match /profiles/{userId} {
      // Everyone reads their own profile; only the superadmin lists or reads others.
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();
      // Only the superadmin creates admins, and never another superadmin.
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['role', 'email', 'created_at', 'created_by'])
        && request.resource.data.role == 'admin';
      allow update: if isSuperAdmin()
        && resource.data.role == 'admin'
        && request.resource.data.role == 'admin'
        && request.resource.data.keys().hasOnly(['role', 'email', 'created_at', 'created_by']);
      // Removing an admin takes away their access. The superadmin cannot be removed here.
      allow delete: if isSuperAdmin() && resource.data.role == 'admin';
    }

    // The master password's proof. Nobody can read it; only the superadmin can replace it.
    match /system/{docId} {
      allow read: if false;
      allow create, update: if docId == 'config'
        && isSuperAdmin()
        && request.resource.data.keys().hasOnly(['master_proof', 'updated_at'])
        && request.resource.data.master_proof is string
        && request.resource.data.master_proof.size() == 64;
      allow delete: if false;
    }

    match /delete_grants/{grantId} {
      allow read: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['uid', 'proof', 'created_at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.created_at == request.time
        && exists(/databases/$(database)/documents/system/config)
        && request.resource.data.proof == get(/databases/$(database)/documents/system/config).data.master_proof;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow list: if isAdmin();
      allow list: if resource.data.public_visible == true;
      allow get: if isAdmin() || resource.data.public_visible == true;
      allow create, update: if isAdmin();
      // Deleting a tournament needs the master password (a delete grant, see above).
      allow delete: if isAdmin() && hasDeleteGrant('tournament-' + tournamentId);

      match /events/{eventId} {
        allow list: if isAdmin();
        allow list: if resource.data.status in ['upcoming', 'ongoing'];
        allow get: if isAdmin() || resource.data.status in ['upcoming', 'ongoing'];
        allow create, update: if isAdmin();
        // Same as tournaments: a division is deleted only with a delete grant.
        // (Deleting the whole tournament removes its divisions, so its grant counts too.)
        allow delete: if isAdmin()
          && (hasDeleteGrant('event-' + eventId) || hasDeleteGrant('tournament-' + tournamentId));
      }
    }

    match /teams/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /team_players/{docId} {
      allow list: if isAdmin();
      allow list: if teamIsPublic(resource.data.team_id);
      allow get: if isAdmin() || teamIsPublic(resource.data.team_id);
      allow create, update, delete: if isAdmin();
    }

    match /players/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /pairs/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /tournament_entries/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /groups/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update: if isAdmin()
        && scopedEventFields()
        && isString(request.resource.data.label);
      allow delete: if isAdmin();
    }

    match /group_members/{docId} {
      allow list: if isAdmin();
      allow list: if groupIsPublic(resource.data.group_id);
      allow get: if isAdmin() || groupIsPublic(resource.data.group_id);
      allow create, update: if isAdmin()
        && isString(request.resource.data.group_id)
        && isString(request.resource.data.entry_id);
      allow delete: if isAdmin();
    }

    match /group_matches/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create: if isAdmin() && validMatchWrite() && isString(request.resource.data.group_id);
      // Who plays whom, and in which group, never changes after creation.
      allow update: if isAdmin() && validMatchWrite()
        && request.resource.data.group_id == resource.data.group_id
        && request.resource.data.entry_a_id == resource.data.entry_a_id
        && request.resource.data.entry_b_id == resource.data.entry_b_id;
      allow delete: if isAdmin();
    }

    match /knockout_matches/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update: if isAdmin()
        && scopedEventFields()
        && knockoutRound(request.resource.data.round)
        && isInt(request.resource.data.slot)
        && request.resource.data.bracket_side in ['left', 'right']
        && matchStatus(request.resource.data.status)
        && matchOutcome(request.resource.data.outcome)
        && (request.resource.data.entry_a_id == null || isString(request.resource.data.entry_a_id))
        && (request.resource.data.entry_b_id == null || isString(request.resource.data.entry_b_id))
        && validResult()
        && optionalKnockoutSourceId(request.resource.data.get('source_match_a_id', null))
        && optionalKnockoutSourceId(request.resource.data.get('source_match_b_id', null))
        && optionalSourceFeeder(request.resource.data.get('source_feeder', null))
        && (request.resource.data.get('pending_odd_round', false) is bool)
        && (request.resource.data.get('is_odd_play_in', false) is bool);
      allow delete: if isAdmin();
    }
  }
}
