rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    function isString(v) {
      return v is string;
    }

    function isOptionalString(v) {
      return v == null || v is string;
    }

    function isBool(v) {
      return v is bool;
    }

    function isInt(v) {
      return v is int;
    }

    function eventStatus(v) {
      return v in ['draft', 'upcoming', 'ongoing', 'ended'];
    }

    function eventType(v) {
      return v in ['team', 'single', 'doubles', 'executive'];
    }

    function entryType(v) {
      return v in ['team', 'player', 'pair'];
    }

    function matchStatus(v) {
      return v in ['scheduled', 'completed', 'pending'];
    }

    function knockoutRound(v) {
      return v in ['quarter', 'semi', 'final'];
    }

    function matchOutcome(v) {
      return v in ['normal', 'forfeit', 'no_show', 'dq', 'bye'];
    }

    function eventIsPublic(tournamentId, eventId) {
      return exists(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId))
        && get(/databases/$(database)/documents/tournaments/$(tournamentId)/events/$(eventId)).data.status in ['upcoming', 'ongoing'];
    }

    function teamIsPublic(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId))
        && eventIsPublic(
          get(/databases/$(database)/documents/teams/$(teamId)).data.tournament_id,
          get(/databases/$(database)/documents/teams/$(teamId)).data.event_id
        );
    }

    function groupIsPublic(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId))
        && eventIsPublic(
          get(/databases/$(database)/documents/groups/$(groupId)).data.tournament_id,
          get(/databases/$(database)/documents/groups/$(groupId)).data.event_id
        );
    }

    function scopedEventFields() {
      return isString(request.resource.data.tournament_id)
        && isString(request.resource.data.event_id);
    }

    function validMatchWrite() {
      return scopedEventFields()
        && isString(request.resource.data.entry_a_id)
        && isString(request.resource.data.entry_b_id)
        && matchStatus(request.resource.data.status)
        && matchOutcome(request.resource.data.outcome)
        && (request.resource.data.score_a == null || isInt(request.resource.data.score_a))
        && (request.resource.data.score_b == null || isInt(request.resource.data.score_b))
        && (request.resource.data.winner_entry_id == null || isString(request.resource.data.winner_entry_id));
    }

    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['role'])
        && request.resource.data.role == 'admin';
      allow delete: if isAdmin();
    }

    match /tournaments/{tournamentId} {
      allow list: if isAdmin();
      allow list: if resource.data.public_visible == true;
      allow get: if isAdmin() || resource.data.public_visible == true;
      allow create, update, delete: if isAdmin();

      match /events/{eventId} {
        allow list: if isAdmin();
        allow list: if resource.data.status in ['upcoming', 'ongoing'];
        allow get: if isAdmin() || resource.data.status in ['upcoming', 'ongoing'];
        allow create, update, delete: if isAdmin();
      }
    }

    match /teams/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /team_players/{docId} {
      allow list: if isAdmin();
      allow list: if teamIsPublic(resource.data.team_id);
      allow get: if isAdmin() || teamIsPublic(resource.data.team_id);
      allow create, update, delete: if isAdmin();
    }

    match /players/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /pairs/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /tournament_entries/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update, delete: if isAdmin();
    }

    match /groups/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update: if isAdmin()
        && scopedEventFields()
        && isString(request.resource.data.label);
      allow delete: if isAdmin();
    }

    match /group_members/{docId} {
      allow list: if isAdmin();
      allow list: if groupIsPublic(resource.data.group_id);
      allow get: if isAdmin() || groupIsPublic(resource.data.group_id);
      allow create, update: if isAdmin()
        && isString(request.resource.data.group_id)
        && isString(request.resource.data.entry_id);
      allow delete: if isAdmin();
    }

    match /group_matches/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update: if isAdmin() && validMatchWrite() && isString(request.resource.data.group_id);
      allow delete: if isAdmin();
    }

    match /knockout_matches/{docId} {
      allow list: if isAdmin();
      allow list: if eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow get: if isAdmin() || eventIsPublic(resource.data.tournament_id, resource.data.event_id);
      allow create, update: if isAdmin()
        && scopedEventFields()
        && knockoutRound(request.resource.data.round)
        && isInt(request.resource.data.slot)
        && request.resource.data.bracket_side in ['left', 'right']
        && matchStatus(request.resource.data.status)
        && matchOutcome(request.resource.data.outcome)
        && (request.resource.data.entry_a_id == null || isString(request.resource.data.entry_a_id))
        && (request.resource.data.entry_b_id == null || isString(request.resource.data.entry_b_id))
        && (request.resource.data.score_a == null || isInt(request.resource.data.score_a))
        && (request.resource.data.score_b == null || isInt(request.resource.data.score_b))
        && (request.resource.data.winner_entry_id == null || isString(request.resource.data.winner_entry_id));
      allow delete: if isAdmin();
    }
  }
}
